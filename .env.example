# Used only by docker-compose.local.yml. The setup script copies this file to
# .env when it does not already exist.
POSTGRES_PASSWORD=upstand-local-password
BETTER_AUTH_SECRET=upstand-local-development-secret-that-is-at-least-32-characters
# Dedicated HMAC key for server-signed UpGal tool approvals (at least 32 chars).
UPGAL_TOOL_APPROVAL_SECRET=upgal-local-approval-secret-that-is-at-least-32-characters
# Mode configuration: false for Self-Hosted (default, single owner setup), true for Cloud (open sign-ups).
IS_CLOUD=false
# `bun dev:self-hosted` and `bun dev:cloud` replace these with isolated values.
COMPOSE_PROJECT_NAME=upstand-local-self-hosted
DOCKER_NETWORK=upstand-network
UPSTAND_POSTGRES_VOLUME=upstand-postgres-data-v18-self-hosted
UPSTAND_REDIS_VOLUME=upstand-redis-data-self-hosted
UPSTAND_WEB_CACHE_VOLUME=upstand-web-next-cache-self-hosted
UPSTAND_FUMADOCS_CACHE_VOLUME=upstand-fumadocs-next-cache-self-hosted
# Optional explicit super admin / instance owner user ID or email override.
UPSTAND_INSTANCE_OWNER_USER_ID=
UPSTAND_INSTANCE_OWNER_EMAIL=
# Optional trusted MCP Apps servers; leave empty to keep the default tool surface.
UPGAL_MCP_SERVERS=[]
UPGAL_ALLOW_CUSTOM_BASE_URL=false
# Conservative per-organization AI cost admission controls. Set the rate above
# the highest applicable provider/model rate; provider billing quotas remain
# required for the final account-level spend boundary.
UPGAL_DAILY_COST_LIMIT_USD=100
UPGAL_MAX_COST_PER_MILLION_TOKENS_USD=100
# Optional exact comma-separated model IDs; leave empty to allow configured providers.
UPGAL_ALLOWED_MODELS=
# Optional public web search for UpGal. Obtain a Brave Search API key and keep
# this value server-side; UpGal returns only bounded, cited result metadata.
UPGAL_WEB_SEARCH_API_KEY=
# Optional HTTPS-compatible Brave Search API endpoint override.
UPGAL_WEB_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
