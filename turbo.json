{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "DOCKER_NETWORK",
    "LOCAL_API_URL",
    "LOCAL_WEB_URL",
    "LOCAL_DOCS_URL",
    "LOCAL_VERIFY_TIMEOUT_MS",
    "LOCAL_EXPECTED_MODE",
    "LOCAL_RUNTIME",
    "IS_CLOUD"
  ],
  "boundaries": {
    "tags": {
      "domain": { "dependencies": { "allow": ["tooling"] } },
      "application": {
        "dependencies": {
          "allow": [
            "configuration",
            "domain",
            "platform",
            "runtime-infrastructure",
            "tooling"
          ]
        }
      },
      "platform": {
        "dependencies": { "allow": ["configuration", "tooling"] }
      },
      "runtime-infrastructure": {
        "dependencies": { "allow": ["configuration", "tooling"] }
      },
      "infrastructure": {
        "dependencies": {
          "allow": [
            "application",
            "configuration",
            "domain",
            "infrastructure",
            "platform",
            "runtime-infrastructure",
            "tooling"
          ]
        }
      },
      "interface": { "dependencies": { "allow": ["domain", "tooling"] } },
      "composition": {
        "dependencies": {
          "allow": [
            "application",
            "composition",
            "configuration",
            "domain",
            "infrastructure",
            "platform",
            "runtime-infrastructure",
            "tooling"
          ]
        }
      },
      "configuration": { "dependencies": { "allow": ["tooling"] } },
      "tooling": { "dependencies": { "allow": [] } },
      "host": {
        "dependencies": {
          "allow": [
            "application",
            "composition",
            "configuration",
            "domain",
            "infrastructure",
            "interface",
            "platform",
            "runtime-infrastructure",
            "tooling"
          ]
        }
      }
    }
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "cache": true,
      "outputs": []
    },
    "test:e2e": {
      "cache": false,
      "env": [
        "E2E_BASE_URL",
        "E2E_SERVER_AVAILABLE",
        "E2E_AUTH_COOKIE",
        "E2E_API_KEY",
        "E2E_RESOURCE_ID",
        "E2E_ORGANIZATION_ID",
        "E2E_BACKUP_DESTINATION_ID",
        "E2E_ALLOW_MUTATIONS",
        "E2E_REQUEST_TIMEOUT_MS"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:check": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:generate": {
      "cache": false,
      "env": [
        "BETTER_AUTH_URL",
        "CORS_ORIGIN",
        "BETTER_AUTH_SECRET",
        "ENCRYPTION_KEY_V1",
        "DATABASE_URL"
      ]
    },
    "db:migrate": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL"]
    },
    "db:start": {
      "cache": false,
      "persistent": true
    },
    "db:stop": {
      "cache": false
    },
    "db:watch": {
      "cache": false,
      "persistent": true
    },
    "db:down": {
      "cache": false
    }
  }
}
