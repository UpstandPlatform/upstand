{
  "name": "@upstand/cli",
  "version": "0.1.1",
  "description": "The OpenTUI-powered command-line interface for Upstand.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UpstandPlatform/upstand.git",
    "directory": "packages/cli"
  },
  "homepage": "https://upstand.dev/docs/operations/cli",
  "bugs": {
    "url": "https://github.com/UpstandPlatform/upstand/issues"
  },
  "type": "module",
  "bin": {
    "upstand": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm --sourcemap=external --packages external",
    "check-types": "tsc --noEmit",
    "dev": "bun run src/index.ts",
    "lint": "biome check .",
    "test": "bun test src"
  },
  "dependencies": {
    "@opentui/core": "^0.4.5",
    "@opentui/keymap": "^0.4.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@upstand/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
