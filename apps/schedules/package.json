{
  "name": "schedules",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile schedules",
    "dev": "cd ../../ && bun --env-file=apps/schedules/.env apps/schedules/src/index.ts",
    "start": "bun run dist/index.mjs",
    "lint": "biome check ."
  },
  "dependencies": {
    "@circulo-ai/di": "catalog:",
    "@upstand/api": "workspace:*",
    "@upstand/db": "workspace:*",
    "@upstand/domain": "workspace:*",
    "@upstand/env": "workspace:*",
    "@upstand/infrastructure": "workspace:*",
    "@upstand/redis": "workspace:*",
    "@upstand/usecases": "workspace:*",
    "bullmq": "catalog:",
    "evlog": "catalog:",
    "hono": "catalog:",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@upstand/config": "workspace:*",
    "tsdown": "^0.22.14",
    "typescript": "catalog:"
  }
}
