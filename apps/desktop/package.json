{
  "name": "desktop",
  "productName": "Upstand",
  "version": "0.2.26",
  "private": true,
  "description": "Upstand Desktop - secure native client for the Upstand control plane",
  "author": "Upstand Contributors",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "bun run ./build/build.ts",
    "dev": "bun run ./scripts/dev.ts",
    "package": "bun run ./build/build.ts --package && electron-forge package",
    "make": "bun run ./build/build.ts --package && electron-forge make",
    "verify:packaged-server": "bun run ./scripts/verify-packaged-server-runtime.ts",
    "check-types": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun test test"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/shared-types": "^7.11.1",
    "@types/bun": "catalog:",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.2.0",
    "electron": "^43.3.0",
    "electron-squirrel-startup": "^1.0.1",
    "typescript": "catalog:"
  }
}
