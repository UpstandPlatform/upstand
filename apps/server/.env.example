# Local-only values. Copy this file to .env or run `bun setup`.
DATABASE_URL=postgresql://postgres:upstand-local-password@localhost:5432/upstand
BETTER_AUTH_SECRET=upstand-local-development-secret-that-is-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
# Enable only when a trusted reverse proxy overwrites forwarded headers.
TRUSTED_PROXY_HEADERS=false
# Optional explicit parent domain for API/dashboard session sharing.
AUTH_COOKIE_DOMAIN=
# Comma-separated private Vault/1Password hosts explicitly trusted for SSRF-safe access.
UPSTAND_SECRET_PROVIDER_ALLOWED_HOSTS=
REDIS_URL=redis://localhost:6379
NODE_ENV=development
IS_CLOUD=false
ENCRYPTION_KEY_V1=MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=
UPSTAND_INSTANCE_OWNER_USER_ID=
UPSTAND_INSTANCE_OWNER_EMAIL=
# The managed OpenResty edge owns public :80/:443; Caddy is moved behind it.
UPSTAND_EDGE_BACKEND=false
UPSTAND_EDGE_BACKEND_HTTP_PORT=8080
UPSTAND_EDGE_BACKEND_HTTPS_PORT=8443
UPSTAND_OPENRESTY_MANAGEMENT_URL=http://127.0.0.1:8090
UPSTAND_OPENRESTY_MANAGEMENT_TOKEN=upstand-local-edge-management-token
