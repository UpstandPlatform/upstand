# Local-only values. Copy this file to .env or run `bun setup`.
DATABASE_URL=postgresql://postgres:upstand-local-password@localhost:5432/upstand
UPSTAND_DATABASE_POOL_MAX=20
UPSTAND_DATABASE_POOL_IDLE_TIMEOUT_MS=30000
UPSTAND_DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
# Production installer aliases for independently managed HA data services.
# UPSTAND_DATABASE_URL=postgresql://user:password@managed-postgres.example.com:5432/upstand
# UPSTAND_REDIS_URL=rediss://:password@managed-redis.example.com:6380
BETTER_AUTH_SECRET=upstand-local-development-secret-that-is-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
# Keep false in production; only enable for an isolated direct-HTTP bootstrap.
UPSTAND_ALLOW_INSECURE_BOOTSTRAP=false
# Enable only when a trusted reverse proxy overwrites forwarded headers.
TRUSTED_PROXY_HEADERS=false
# Optional explicit parent domain for API/dashboard session sharing.
AUTH_COOKIE_DOMAIN=
# Comma-separated private Vault/1Password hosts explicitly trusted for SSRF-safe access.
UPSTAND_SECRET_PROVIDER_ALLOWED_HOSTS=
# Comma-separated exact Git provider hosts allowed for outbound integrations.
UPSTAND_GIT_PROVIDER_ALLOWED_HOSTS=
# Comma-separated exact hosts allowed for private notification/S3 endpoints.
UPSTAND_OUTBOUND_ALLOWED_HOSTS=
# Deadline for each external Docker/rclone/WAL-G backup command (30 minutes).
UPSTAND_BACKUP_COMMAND_TIMEOUT_MS=1800000
# Structured schedules operational alerts are emitted through Evlog/OTLP.
UPSTAND_OPERATIONAL_MONITOR_INTERVAL_MS=60000
UPSTAND_QUEUE_ALERT_WAITING_THRESHOLD=1000
UPSTAND_QUEUE_ALERT_FAILED_THRESHOLD=1
UPSTAND_OUTBOX_ALERT_PENDING_THRESHOLD=1000
UPSTAND_OUTBOX_ALERT_DEAD_LETTER_THRESHOLD=1
# Set to 0 only when the installation has a separate backup freshness monitor.
UPSTAND_BACKUP_ALERT_MAX_AGE_MS=172800000
# Set true when a successful backup is mandatory before accepting operations.
UPSTAND_BACKUP_ALERT_REQUIRE_SUCCESS=false
# Audit records are pruned in bounded batches after this many days.
UPSTAND_AUDIT_LOG_RETENTION_DAYS=365

# Optional OTLP collector endpoint. Production installs should configure this
# or explicitly acknowledge missing telemetry in the installer.
# OTLP_ENDPOINT=https://otel-collector.example.com/v1/logs
REDIS_URL=redis://localhost:6379
DOCKER_NETWORK=upstand-network
NODE_ENV=development
IS_CLOUD=false
ENCRYPTION_KEY_V1=MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=
UPSTAND_INSTANCE_OWNER_USER_ID=
UPSTAND_INSTANCE_OWNER_EMAIL=
